{
  "name": "tikvo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc --noEmit -p pipeline/tsconfig.json",
    "pipeline:test": "node --test pipeline/test/*.test.ts",
    "remotion:preview": "remotion studio pipeline/remotion/index.ts",
    "pipeline:smoke": "tsx pipeline/smoke.ts",
    "pipeline:render": "tsx pipeline/render.ts",
    "pipeline:publish": "tsx pipeline/publish.ts",
    "worker:typecheck": "tsc --noEmit -p worker/tsconfig.json",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@remotion/bundler": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/player": "^4.0.539",
    "@remotion/renderer": "4.0.539",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "remotion": "^4.0.539",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.0.0"
  }
}
